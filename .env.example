# Lead formlarinin e-posta bildirimi (Resend)
# Vercel > Project Settings > Environment Variables altina eklenir.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Bildirimin dusecegi adres
LEAD_MAIL_TO=hello@studiogria.com

# Gonderen adres.
# Resend'de studiogria.com domaini dogrulanana kadar asagidaki test adresi kullanilir.
# Domain dogrulandiktan sonra: Studio Gria <bildirim@studiogria.com>
LEAD_MAIL_FROM=Studio Gria <onboarding@resend.dev>

# Meta Pixel ID (opsiyonel, tanimlanmazsa kod icindeki deger kullanilir)
NEXT_PUBLIC_META_PIXEL_ID=1657840648966297

# Form biletlerini imzalayan gizli anahtar.
# Tanimlanmazsa kod dagitima ozgu bir yedek degere duser, ama bu anahtarin
# acikca tanimlanmasi daha guvenlidir. Uretmek icin:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LEAD_BILET_SECRET=
